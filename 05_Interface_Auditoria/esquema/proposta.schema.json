{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Proposta de engenharia (Protocolo de Auditoria v1.0)",
  "type": "object",
  "required": ["protocolo", "id", "titulo", "autor", "data", "tipo", "base_commit",
               "objetivo", "parametros", "esperado", "nao_muda", "justificativa", "riscos"],
  "properties": {
    "protocolo": {"type": "string", "const": "1.0"},
    "id": {"type": "string", "pattern": "^PRP-[0-9]{4}$"},
    "titulo": {"type": "string", "minLength": 5},
    "autor": {"type": "string", "minLength": 2},
    "data": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "tipo": {"type": "string", "enum": ["calculo", "geometria", "processo"]},
    "base_commit": {"type": "string", "minLength": 7},
    "objetivo": {"type": "string", "minLength": 10},
    "arquivos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["caminho", "sha256"],
        "properties": {
          "caminho": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "operacao": {"type": "string", "enum": ["novo", "substituido"]}
        }
      }
    },
    "parametros": {
      "type": "object",
      "description": "O que muda. O Auditor aceita apenas as chaves documentadas em PROTOCOLO_AUDITORIA.md §5.",
      "properties": {
        "land_total_mm": {"type": "number", "minimum": 8.5, "maximum": 12.0},
        "chanfro_mm": {"type": "number", "minimum": 0.5, "maximum": 1.5}
      },
      "additionalProperties": true
    },
    "esperado": {
      "type": "object",
      "description": "Previsão numérica. Chaves não reconhecidas entram em 'nao_auditavel'.",
      "additionalProperties": {"type": "number"}
    },
    "nao_muda": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "justificativa": {"type": "string", "minLength": 20},
    "riscos": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "cfd_requerido": {"type": "boolean"},
    "observacoes": {"type": "string"}
  }
}
